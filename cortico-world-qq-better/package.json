{
  "name": "cortico-world-qq-final",
  "version": "0.1.61",
  "description": "Cortico World 扩展：QQ（OneBot v11 / NapCat）适配器，并整合桌宠(cortico-world-desktop-pet, AGPL-3.0)与电脑操控(cortico-world-cua, AGPL-3.0)能力。",
  "type": "module",
  "main": "./src/index.ts",
  "files": ["src", "dist", "web", "host", "README.md", "ENV_PROMPT.md", "asr_sidecar.py", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "license": "AGPL-3.0-or-later",
  "keywords": ["cortico-world", "qq", "onebot", "napcat", "desktop-pet"],
  "cortico": {
    "kind": "world",
    "api": 5,
    "label": "QQ_bot",
    "consoleClient": "dist/console.js",
    "consoleStyle": "dist/console.css"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "build:console": "node scripts/build-console.mjs",
    "test": "node --test tests/normalize.test.ts tests/config.test.ts"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "koffi": "3.3.1",
    "opencc-js": "^1.4.1",
    "sherpa-onnx-node": "1.13.8",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "electron": "44.4.4",
    "typescript": "^5.7.0"
  }
}
