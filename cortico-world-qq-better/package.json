{
  "name": "cortico-world-qq-final",
  "version": "0.1.61",
  "description": "Cortico World 扩展：QQ（OneBot v11 / NapCat）适配器。",
  "type": "module",
  "main": "./src/index.ts",
  "files": ["src", "dist", "README.md", "ENV_PROMPT.md", "asr_sidecar.py", "LICENSE"],
  "license": "MIT",
  "keywords": ["cortico-world", "qq", "onebot", "napcat"],
  "cortico": {
    "kind": "world",
    "api": 5,
    "label": "QQ_bot",
    "consoleClient": "dist/console.js",
    "consoleStyle": "dist/console.css"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "build:console": "node scripts/build-console.mjs",
    "test": "node --test tests/normalize.test.ts tests/config.test.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  }
}
